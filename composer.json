{
    "name": "gameserverapp/community-website",
    "description": "The GameServerApp.com Community website.",
    "keywords": ["gameserverapp", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.2",
        "barryvdh/laravel-debugbar": "^3.2",
        "bugsnag/bugsnag-laravel": "^2.0",
        "dompdf/dompdf": "^2.0",
        "graham-campbell/markdown": "^11.0",
        "guzzlehttp/guzzle": "^6.3",
        "laravel/framework": "^6.20",
        "laravel/helpers": "^1.2",
        "laravel/tinker": "^2.0",
        "laravelcollective/html": "^6.0",
        "predis/predis": "^1.1",
        "webuni/commonmark-table-extension": "^2.1"
    },
    "require-dev": {
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^3.0",
        "phpunit/phpunit": "^8.5"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "GameserverApp\\": "app/GameserverApp"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
